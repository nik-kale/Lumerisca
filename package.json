{
  "name": "lumerisca",
  "version": "0.1.0",
  "private": true,
  "description": "Page-aware AI assistant with scoped RAG and in-browser analysis",
  "keywords": ["chrome-extension", "ai", "rag", "llm", "browser-assistant"],
  "author": "Lumerisca Contributors",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @lumerisca/core build",
    "build:extension": "pnpm --filter @lumerisca/extension-chrome build",
    "dev:extension": "pnpm --filter @lumerisca/extension-chrome dev",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean",
    "test": "pnpm -r test",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "@typescript-eslint/parser": "^6.19.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-config-prettier": "^9.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
